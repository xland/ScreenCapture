			VALUE "OriginalFilename", "ImageReader.exe"
			VALUE "ProductName", "ImageReader"
			VALUE "ProductVersion", "1.0.0.0"
		END
		END
		BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x804, 1200
	END
